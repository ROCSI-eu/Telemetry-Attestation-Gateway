# TAG #88 / PERSISTENT-RUNTIME-03 / SIMPLIFICATION-02 — non-Production template.
# Root-only install creates a stable, empty host mountpoint once; no cleanup unit.
# Installed disabled. Any enable/start/integrated QA needs separate approval.
[Unit]
Description=TAG experimental persistent loopback console (synthetic only)
AssertPathIsDirectory=/var/lib/tag-qa88/runtime
AssertPathIsMountPoint=!/var/lib/tag-qa88/runtime
StartLimitIntervalSec=60
StartLimitBurst=2

[Service]
Type=exec
User=tag-qa88
Group=tag-qa88
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LimitCORE=0
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
PrivateDevices=yes
KillMode=control-group
TimeoutStopSec=2s
Slice=tag-qa88.slice
MemoryAccounting=yes
TasksAccounting=yes
MemoryMax=134217728
MemorySwapMax=0
CPUQuota=50%
TasksMax=12
# Per-unit mount namespace; host backing directory persists, empty.
# Never configure RuntimeDirectory/ReadWritePaths at this same mountpoint.
TemporaryFileSystem=/var/lib/tag-qa88/runtime:size=8388608,nr_inodes=128,mode=0700,uid=@TAG_UID@,gid=@TAG_GID@,nodev,nosuid,noexec
RuntimeDirectory=tag-qa88-control
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/
# Read-only privileged check of the host anchor and private mount; no mutations.
ExecStartPre=+/usr/bin/python3 -B @TAG_RELEASE@/scripts/tag88_service.py mount-verify
ExecStart=/usr/bin/python3 -B @TAG_RELEASE@/experiments/web-console-v0/local_cli_bridge.py --persistent --runtime-root /var/lib/tag-qa88/runtime --operator-token-file /run/tag-qa88-control/operator.token
Restart=no

[Install]
WantedBy=multi-user.target
