# TAG #88 / PERSISTENT-RUNTIME-02 — renderable non-Production template.
# The root-only installer substitutes @TAG_RELEASE@ and numeric UID/GID.
# Install places this disabled; enabling/start/reboot require separate approval.
[Unit]
Description=TAG experimental persistent loopback console (synthetic only)
StartLimitIntervalSec=60
StartLimitBurst=2

[Service]
Type=simple
User=tag-qa88
Group=tag-qa88
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LimitCORE=0
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
PrivateDevices=yes
KillMode=control-group
TimeoutStopSec=2s
Slice=tag-qa88.slice
MemoryAccounting=yes
TasksAccounting=yes
MemoryMax=134217728
MemorySwapMax=0
CPUQuota=50%
TasksMax=12
# One bounded outer runtime mount; CLI /tmp binds its own disposable workdir
# within this same filesystem (no independent inner tmpfs).
# Requires a pre-created, empty root:root 0700 /run/tag-qa88 mountpoint.
# Do not add ReadWritePaths= or RuntimeDirectory= for this same path:
# systemd 259 can prioritize those entries over the bounded tmpfs.
TemporaryFileSystem=/run/tag-qa88:size=8388608,nr_inodes=128,mode=0700,uid=@TAG_UID@,gid=@TAG_GID@,nodev,nosuid,noexec
# Only owner-readable operator credential, on the host /run tmpfs.
# This tiny control-plane directory is deliberately outside the CLI runtime cap.
RuntimeDirectory=tag-qa88-control
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/
# Root-only hooks are fixed, narrowly scoped; main process remains unprivileged.
ExecStartPre=+/usr/bin/python3 -B @TAG_RELEASE@/scripts/tag88_service.py mount-prepare
ExecStart=/usr/bin/python3 -B @TAG_RELEASE@/experiments/web-console-v0/local_cli_bridge.py --persistent --runtime-root /run/tag-qa88 --operator-token-file /run/tag-qa88-control/operator.token
ExecStopPost=+/usr/bin/python3 -B @TAG_RELEASE@/scripts/tag88_service.py mount-clean
Restart=no

[Install]
WantedBy=multi-user.target
